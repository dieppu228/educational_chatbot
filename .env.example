# API server
EDUBOT_HOST=127.0.0.1
EDUBOT_PORT=8000
EDUBOT_API_TITLE=EduBot API

# Gemini / LLM
GENAI_API_KEY=
GENAI_BASE_URL=
GENAI_API_VERSION=
GENAI_TIMEOUT_SECONDS=60
LLM_MODEL=gemini-2.5-flash-lite

# Tavily web search
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_INCLUDE_IMAGES=true
TAVILY_INCLUDE_IMAGE_DESCRIPTIONS=true
TAVILY_TIMEOUT_SECONDS=15

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=educational_chatbot
QDRANT_VECTOR_SIZE=768
QDRANT_TIMEOUT_SECONDS=60
QDRANT_UPLOAD_BATCH_SIZE=128
QDRANT_SCROLL_BATCH_SIZE=512

# Local embedding / reranker models
EMBEDDING_MODEL=dangvantuan/vietnamese-document-embedding
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=64
RERANKER_MODEL=AITeamVN/Vietnamese_Reranker
RERANKER_DEVICE=

# Retrieval
RETRIEVER_TOP_K=25
RERANKER_TOP_N=5
RERANKER_TOP_N_SLIDE=15
RERANKER_TOP_N_LESSON_PLAN=20
RERANKER_MIN_SCORE=0.0
RRF_K_WEIGHT=60
RAG_BROAD_MAX_CHUNKS=30

# Question generation / scoring
MIN_QUESTIONS=1
MAX_QUESTIONS=10
DEFAULT_QUESTIONS=3
QUESTION_GENERATION_TEMPERATURE=0.5
SCORING_TEMPERATURE=0.0

# Runtime paths
DATA_DIR=data
CHUNKS_FILE=rag_chunks_v2.json
EMBEDDINGS_FILE=embeddings.npy
EMBEDDINGS_META_FILE=embeddings.meta.json
SESSION_STORAGE_DIR=data/sessions
FRONTEND_DIST_DIR=app/frontend/dist
SLIDE_TEMPLATE_PATH=app/templates/default_slide_template.pptx
SLIDE_EXPORT_DIR=app/data/exports
SLIDE_DOWNLOAD_BASE_URL=/api/exports
LOG_DIR=logs
LOG_FILE=app.log
EMBEDDING_FAILURE_LOG_FILE=embedding_failures.txt
LOG_LEVEL=INFO
E2E_LOG_DIR=logs/e2e_runs
E2E_TIMEOUT_SECONDS=10000

# Chunk classification
CHUNK_TYPE_MODEL=gemini-2.5-flash-lite
CHUNK_TYPE_CACHE_FILE=chunk_type_cache.json
CHUNK_TYPE_BATCH_SIZE=20
CHUNK_TYPE_TIMEOUT_SECONDS=45

# Evaluation
EVAL_NUM_SAMPLES=250
EVAL_LLM_MODEL=gemini-2.5-flash-lite
EVAL_EMBEDDING_MODEL=dangvantuan/vietnamese-document-embedding
EVAL_OUTPUT_DIR=data/eval/ragas
EVAL_MAX_WORKERS=2
EVAL_MAX_RETRIES=10
EVAL_MAX_WAIT_SECONDS=30

# Remote media download for PPTX export
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=8
MEDIA_DOWNLOAD_MAX_BYTES=8388608
