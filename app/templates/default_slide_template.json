    "EDU_EXERCISE": {"name": "Title and Content", "roles": {"title": {"idx": 0, "types": ["TITLE"]}, "body": {"idx": 1, "types": ["OBJECT"]}}},
    "EDU_ANSWER_KEY": {"name": "Title and Content", "roles": {"title": {"idx": 0, "types": ["TITLE"]}, "body": {"idx": 1, "types": ["OBJECT"]}}},
    "EDU_SUMMARY": {"name": "Section Header", "roles": {"title": {"idx": 0, "types": ["TITLE"]}, "body": {"idx": 1, "types": ["BODY"]}}}
